# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env.production and fill in your values
# NEVER commit actual production values to version control

# ========================================
# BASIC CONFIGURATION
# ========================================
NODE_ENV=production
PORT=3000

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USERNAME=your-production-db-user
DB_PASSWORD=your-strong-production-password
DB_DATABASE=education_production_db
DB_SYNC=false
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=5

# ========================================
# JWT CONFIGURATION
# ========================================
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=educational-platform
JWT_AUDIENCE=educational-platform-users

# ========================================
# SECURITY CONFIGURATION
# ========================================
CORS_ORIGIN=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_CREDENTIALS=true
SESSION_SECRET=your-session-secret
SESSION_MAX_AGE=86400

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
UPLOAD_DIR=/var/uploads
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.jpg,.jpeg,.png,.gif,.webp,.svg,.mp4,.webm,.ogg,.avi,.mov,.mp3,.wav,.ogg,.m4a,.zip,.rar,.7z,.tar,.gz
ENABLE_FILE_SCANNING=true

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
RATE_LIMIT_AUTH_TTL=300000
RATE_LIMIT_AUTH_LIMIT=5

# ========================================
# AUDIT LOGGING
# ========================================
AUDIT_LOG_TO_FILE=true
AUDIT_LOG_TO_DB=true
LOG_LEVEL=info
LOG_FILE_PATH=/var/logs/educational-platform
LOG_MAX_SIZE=100
LOG_MAX_DAYS=30

# ========================================
# SSL CONFIGURATION
# ========================================
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key
SSL_CA_PATH=/etc/ssl/certs/your-domain-ca.crt

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=10000

# ========================================
# EMAIL CONFIGURATION
# ========================================
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SECURE=true
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Educational Platform

# ========================================
# MONITORING & HEALTH CHECKS
# ========================================
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30000
METRICS_ENDPOINT=/metrics

# ========================================
# BACKUP & RECOVERY
# ========================================
ENABLE_AUTO_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/var/backups/educational-platform

# ========================================
# PERFORMANCE TUNING
# ========================================
# Database connection pool settings
# DB_POOL_MAX=20
# DB_POOL_MIN=5

# File upload limits
# MAX_FILE_SIZE=104857600

# Rate limiting
# RATE_LIMIT_TTL=60000
# RATE_LIMIT_LIMIT=100
