# ⚠️ IMPORTANT: This is an EXAMPLE file. Copy to .env and replace all values with your own credentials.
# Never commit the .env file to version control!

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE
DB_DATABASE=education_db

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (⚠️ Generate a strong random secret in production)
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=24h

# CORS Configuration
CLIENT_URL=http://localhost:80
