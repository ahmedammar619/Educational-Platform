# ========================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ========================================
# Copy this file to .env for local development

# ========================================
# BASIC CONFIGURATION
# ========================================
NODE_ENV=development
PORT=3000

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=education_dev_db
DB_SYNC=true
DB_LOGGING=true
DB_POOL_MAX=10
DB_POOL_MIN=2

# ========================================
# JWT CONFIGURATION
# ========================================
JWT_SECRET=dev-jwt-secret-change-in-production-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=educational-platform-dev
JWT_AUDIENCE=educational-platform-dev-users

# ========================================
# SECURITY CONFIGURATION
# ========================================
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
CORS_CREDENTIALS=true
SESSION_SECRET=dev-session-secret
SESSION_MAX_AGE=86400

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.jpg,.jpeg,.png,.gif,.webp,.svg,.mp4,.webm,.ogg,.avi,.mov,.mp3,.wav,.ogg,.m4a,.zip,.rar,.7z,.tar,.gz
ENABLE_FILE_SCANNING=false

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=1000
RATE_LIMIT_AUTH_TTL=300000
RATE_LIMIT_AUTH_LIMIT=10

# ========================================
# AUDIT LOGGING
# ========================================
AUDIT_LOG_TO_FILE=true
AUDIT_LOG_TO_DB=false
LOG_LEVEL=debug
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=50
LOG_MAX_DAYS=7

# ========================================
# SSL CONFIGURATION
# ========================================
SSL_ENABLED=false

# ========================================
# MONITORING & HEALTH CHECKS
# ========================================
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=60000
METRICS_ENDPOINT=/metrics

# ========================================
# BACKUP & RECOVERY
# ========================================
ENABLE_AUTO_BACKUP=false
